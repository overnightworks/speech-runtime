{
  "name": "overnightworks-speech-browser",
  "version": "0.14.0",
  "type": "module",
  "license": "MIT",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./capture-worklet.js": "./dist/capture-worklet.js"
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@12.18.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24 || ^26",
      "onFail": "error"
    }
  },
  "scripts": {
    "prepack": "pnpm run build",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.worklet.json --noEmit",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.worklet.json",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/audioworklet": "^0.0.101",
    "@vitest/coverage-v8": "^5.1.0",
    "monocart-coverage-reports": "^3.2.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
